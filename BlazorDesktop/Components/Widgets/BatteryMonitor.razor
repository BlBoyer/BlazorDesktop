<div>
    Keep your battery charged:
    @switch (Battery.State)
    {
        case BatteryState.Full:
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#5EF22C" class="icon icon-tabler icons-tabler-filled icon-tabler-battery-vertical">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M13.5 3a1.5 1.5 0 0 1 1.395 .948l.018 .052h.087a3 3 0 0 1 2.995 2.824l.005 .176v11a3 3 0 0 1 -3 3h-6a3 3 0 0 1 -3 -3v-11a3 3 0 0 1 3 -3h.086l.019 -.052a1.5 1.5 0 0 1 1.25 -.941l.145 -.007z" />
            </svg>
            break;
        case BatteryState.Discharging:
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#CC1010" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-battery-vertical-1">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M7 18v-11a2 2 0 0 1 2 -2h.5a.5 .5 0 0 0 .5 -.5a.5 .5 0 0 1 .5 -.5h3a.5 .5 0 0 1 .5 .5a.5 .5 0 0 0 .5 .5h.5a2 2 0 0 1 2 2v11a2 2 0 0 1 -2 2h-6a2 2 0 0 1 -2 -2" />
                <path d="M10 17h4" />
            </svg>
            break;
        case BatteryState.Charging:
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D9960D" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-battery-vertical-charging-2">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M7 18v-11c0 -1.105 .895 -2 2 -2h.5c.276 0 .5 -.224 .5 -.5s.224 -.5 .5 -.5h3c.276 0 .5 .224 .5 .5s.224 .5 .5 .5h.5c1.105 0 2 .895 2 2v1m-10 10c0 1.105 .895 2 2 2h1" />
                <path d="M12 14h6v2a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2l0 -2" />
                <path d="M15 21v-3" />
                <path d="M13 14v-2.5" />
                <path d="M17 14v-2.5" />
            </svg>
            break;
    }
</div>

@code {

    protected override void OnInitialized()
    {
        Battery.BatteryInfoChanged += Update;
        base.OnInitialized();
	}
	private void Update(object? sender, BatteryInfoChangedEventArgs @event)
    {
        StateHasChanged();
    }
}